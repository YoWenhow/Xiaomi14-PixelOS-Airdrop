{
  "wlan": [
    "make",
    "-C",
    "${KERNEL}",
    "O=${KERNEL_OUT}",
    "ARCH=arm64",
    "LLVM=1",
    "LLVM_IAS=1",
    "PAHOLE=${PAHOLE}",
    "PAHOLE_FLAGS=--btf_gen_floats -j1",
    "LD=ld.lld --thinlto-jobs=2",
    "-j4",
    "M=${WLAN}/qcacld-3.0",
    "CONFIG_QCA_CLD_WLAN=m",
    "MODNAME=qca_cld3_kiwi_v2",
    "CHIP_NAME=kiwi_v2",
    "WLAN_CTRL_NAME=wlan",
    "HOUJI_WMI_C3_PROFILE=1",
    "WLAN_ROOT=${WLAN}/qcacld-3.0",
    "WLAN_PROFILE=kiwi_v2",
    "WLAN_COMMON_ROOT=cmn",
    "WLAN_COMMON_INC=${WLAN}/qca-wifi-host-cmn",
    "WLAN_FW_API=${WLAN}/fw-api",
    "WLAN_PLATFORM_INC=${WLAN}/platform/inc",
    "DATA_IPA_INC=${IPA_INCLUDE}",
    "DATA_IPA_UAPI_INC=${IPA_INCLUDE}/uapi",
    "CONFIG_ARCH_PINEAPPLE=y",
    "CONFIG_IPA_OUT_OF_TREE=y",
    "CONFIG_BUS_AUTO_SUSPEND=y",
    "CONFIG_CNSS2=m",
    "CONFIG_CNSS2_QMI=y",
    "CONFIG_CNSS2_SMMU_DB_SUPPORT=y",
    "CONFIG_CNSS2_SSR_DRIVER_DUMP=y",
    "CONFIG_CNSS_GENL=m",
    "CONFIG_CNSS_HW_SECURE_DISABLE=y",
    "CONFIG_CNSS_HW_SECURE_SMEM=y",
    "CONFIG_CNSS_OUT_OF_TREE=y",
    "CONFIG_CNSS_PLAT_IPC_QMI_SVC=m",
    "CONFIG_CNSS_QMI_SVC=m",
    "CONFIG_CNSS_UTILS=m",
    "CONFIG_WCNSS_MEM_PRE_ALLOC=m",
    "KBUILD_EXTRA_SYMBOLS=${EXTRA_SYMVERS}",
    "KCFLAGS=-D__ANDROID_COMMON_KERNEL__ -DWLAN_FEATURE_11BE_SUPP_NONWPA3 -DWLAN_FEATURE_MULTI_P2P -DWLAN_FEATURE_FAST_CONNECT -Wno-format -fstrict-flex-arrays=0 -I${EXTERNAL_INCLUDE} -DCONFIG_IPA_WDI_UNIFIED_API=1",
    "CONFIG_DRIVER_PASSTHRU_SESSION=y",
    "CONFIG_DRIVER_PASSTHRU_DP=y",
    "CONFIG_DRIVER_PASSTHRU_OWNER=y",
    "CONFIG_DRIVER_PASSTHRU_MODE=y",
    "CONFIG_DRIVER_PASSTHRU_RUNTIME=y",
    "modules",
    "CONFIG_DEBUG_INFO_BTF_MODULES="
  ],
  "bridge": [
    "make",
    "-C",
    "${KERNEL}",
    "O=${KERNEL_OUT}",
    "ARCH=arm64",
    "LLVM=1",
    "LLVM_IAS=1",
    "PAHOLE=${PAHOLE}",
    "PAHOLE_FLAGS=--btf_gen_floats -j2",
    "LD=ld.lld --thinlto-jobs=2",
    "-j2",
    "M=${BRIDGE}",
    "KCFLAGS=-D__ANDROID_COMMON_KERNEL__",
    "modules"
  ],
  "wonder": [
    "make",
    "-C",
    "${KERNEL}",
    "O=${KERNEL_OUT}",
    "ARCH=arm64",
    "LLVM=1",
    "LLVM_IAS=1",
    "KBUILD_KCONFIG=${KCONFIG_WONDER}",
    "PAHOLE=${PAHOLE}",
    "PAHOLE_FLAGS=--btf_gen_floats -j1",
    "LD=ld.lld --thinlto-jobs=1",
    "-j1",
    "M=${WONDER}",
    "KBUILD_EXTRA_SYMBOLS=${WONDER_PROVIDERS}",
    "modules"
  ]
}
