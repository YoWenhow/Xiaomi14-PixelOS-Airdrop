+/* Administrative UP never creates a firmware STA vdev. The matching
+ * close must also work after provider sealing/withdrawal, so its resource
+ * predicate intentionally does not depend on runtime publication.
+ */
+static bool hdd_pt_framework_sta_empty(struct hdd_adapter *adapter)
+{
+	unsigned int i;
+
+	if (!hdd_pt_framework_netdev_mode() ||
+	    adapter->device_mode != QDF_STA_MODE || !adapter->deflink ||
+	    test_bit(DEVICE_IFACE_OPENED, &adapter->event_flags) ||
+	    adapter->deflink->vdev ||
+	    test_bit(SME_SESSION_OPENED, &adapter->deflink->link_flags))
+		return false;
+	for (i = 0; i < WLAN_MAX_ML_BSS_LINKS; i++)
+		if (adapter->link_info[i].vdev ||
+		    test_bit(SME_SESSION_OPENED, &adapter->link_info[i].link_flags))
+			return false;
+	return true;
+}
